{
  "name": "stat-arena",
  "version": "1.0.0",
  "description": "Stat Arena Multiplayer Server",
  "main": "server.js",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "ws": "^8.21.0"
  },
  "scripts": {
    "start": "node server.js",
